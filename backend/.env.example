# ─────────────────────────────────────────────
# ShopVibe Backend — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file to version control.
# ─────────────────────────────────────────────

# ── Server ────────────────────────────────────
# Port the Express server listens on.
# Render injects PORT automatically; leave blank to use its value.
PORT=10000

# ── Database ──────────────────────────────────
# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ── Authentication ────────────────────────────
# Long, random secret used to sign JWTs — change before deploying!
JWT_SECRET=replace_with_a_long_random_secret

# ── CORS / Frontend ───────────────────────────
# Primary frontend origin allowed by the CORS policy.
# Set to your Netlify or custom domain in production.
# Example (Netlify): https://your-site.netlify.app
# Example (local dev): http://127.0.0.1:5500
FRONTEND_URL=http://127.0.0.1:5500

# ── AI / Chatbot ──────────────────────────────
# Google Gemini API key for the AI chatbot feature
GEMINI_API_KEY=your_gemini_api_key_here

# ── Payment Gateway (Razorpay) ────────────────
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ─────────────────────────────────────────────
# Deployment Notes
# ─────────────────────────────────────────────
# Render (Backend):
#   - Set all variables above in the Render dashboard → Environment tab.
#   - PORT is auto-injected by Render; no need to set it manually.
#   - Set FRONTEND_URL to your Netlify URL.
#
# Netlify (Frontend):
#   - The frontend is static HTML/JS — no build step required.
#   - If you ever switch to a bundled framework, add:
#       REACT_APP_API_URL=https://your-render-backend.onrender.com
#     or
#       VITE_API_URL=https://your-render-backend.onrender.com
# ─────────────────────────────────────────────
